// scrml.dev — root program
//
// The official documentation site for the scrml language. Built as a
// scrml multi-page app per the Phase 0 architecture deep-dive at
// scrml-support/docs/deep-dives/scrml-dev-mdn-style-architecture-2026-05-17.md
//
// Dark-theme override block lives at program scope: a real #{} CSS
// context (the canonical scrml mechanism per the css-without-build-step
// article). NOT a file-top placeholder — actual program-global styles.
// Repaints the existing light-theme Tailwind classes via class-level
// overrides so per-page edits aren't required for the dark flip.
//
// Day-1 surface (P1 Deliverable B):
//   - pages/index.scrml — landing (honest current-state framing)
//   - pages/reference/elements/engine.scrml — flagship feature page
//   - pages/reference/elements/errors.scrml — flagship feature page
//   - pages/reference/contexts/sql.scrml — flagship feature page

<program>

    const SITE_NAME = "scrml.dev"
    const SITE_TAGLINE = "Official documentation for the scrml language"
    const VERSION = "v0.7.1"

    #{
        /* ─── base canvas ────────────────────────────────────────── */
        :root {
            color-scheme: dark;
        }
        html, body {
            background-color: rgb(2 6 23);
            color: rgb(226 232 240);
        }
        body {
            font-feature-settings: "ss01", "cv11";
        }

        /* ─── link polish (default + per-page link colors) ──────── */
        a {
            text-underline-offset: 3px;
            transition: color 150ms ease;
        }
        a:hover {
            text-decoration-thickness: 2px;
        }

        /* ─── class overrides — flip light-theme palette to dark ── */
        .bg-white            { background-color: rgb(15 23 42) !important; }
        .bg-slate-50         { background-color: rgb(15 23 42) !important; }
        .bg-slate-100        { background-color: rgb(30 41 59) !important; }
        .text-slate-900      { color: rgb(241 245 249) !important; }
        .text-slate-800      { color: rgb(226 232 240) !important; }
        .text-slate-700      { color: rgb(203 213 225) !important; }
        .text-slate-600      { color: rgb(148 163 184) !important; }
        .text-slate-500      { color: rgb(100 116 139) !important; }
        .border-slate-200    { border-color: rgb(30 41 59) !important; }
        .border-slate-300    { border-color: rgb(51 65 85) !important; }
        .hover\:bg-slate-50:hover    { background-color: rgb(30 41 59) !important; }
        .hover\:bg-slate-800:hover   { background-color: rgb(51 65 85) !important; }
        .hover\:text-slate-900:hover { color: rgb(241 245 249) !important; }

        /* link palette */
        .text-blue-700                { color: rgb(125 211 252) !important; }
        .hover\:text-blue-900:hover   { color: rgb(186 230 253) !important; }
        .text-rose-700                { color: rgb(251 113 133) !important; }
        .hover\:text-rose-900:hover   { color: rgb(254 205 211) !important; }

        /* status banners (queued / since / kind chips) */
        .bg-amber-50                  { background-color: rgb(120 53 15 / 0.22) !important; }
        .border-amber-200             { border-color: rgb(180 83 9 / 0.5) !important; }
        .text-amber-700               { color: rgb(252 211 77) !important; }
        .bg-rose-50                   { background-color: rgb(159 18 57 / 0.25) !important; }
        .bg-emerald-50                { background-color: rgb(6 78 59 / 0.28) !important; }
        .text-emerald-700             { color: rgb(110 231 183) !important; }
        .bg-blue-50                   { background-color: rgb(30 58 138 / 0.30) !important; }

        /* dark variant for prose without per-page edits */
        .prose                        { color: rgb(203 213 225); }
        .prose h1, .prose h2, .prose h3, .prose h4, .prose strong {
            color: rgb(241 245 249);
        }
        .prose a                      { color: rgb(125 211 252); }
        .prose a:hover                { color: rgb(186 230 253); }
        .prose code {
            color: rgb(241 245 249);
            background-color: rgb(30 41 59);
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-weight: 500;
        }
        .prose pre {
            background-color: rgb(2 6 23);
            border: 1px solid rgb(30 41 59);
        }
        /* Code INSIDE a <pre> must take the <pre>'s colour, not the standalone
           inline-code palette. The typography layer ships
           `.prose-slate :where(code) { color: #0f172a }` (a LIGHT-theme value),
           which rendered every fenced example as slate-900 text on the
           slate-900 <pre> background — i.e. the reference pages' code samples
           were invisible. `inherit` is theme-agnostic: the <pre> already
           carries `text-slate-100`. */
        .prose pre code,
        pre code {
            color: inherit !important;
            background-color: transparent !important;
            padding: 0;
            font-weight: inherit;
        }
        .prose blockquote {
            color: rgb(148 163 184);
            border-left-color: rgb(51 65 85);
        }

        /* dark <pre> tweak — slight separation from page bg */
        pre.bg-slate-900 {
            border: 1px solid rgb(30 41 59);
        }

        /* page-body alignment: articles use max-w-3xl with no mx-auto,
           which leaves them packed at the LEFT of main's wider column.
           Centre them so the article axis = viewport centre. */
        article.prose,
        article.prose.max-w-3xl {
            margin-left: auto;
            margin-right: auto;
        }

        /* utility shims — scrml's Tailwind layer doesn't pick up these
           classes from source on its own scan, so define them here.
           Tracked as Bug 1 in handOffs/incoming/2026-05-19-0614-...-dogfood-bug-surface.md */
        .flex-1 { flex: 1 1 0%; }
        .justify-center { justify-content: center; }
        .justify-end    { justify-content: flex-end; }

        /* ─── shell chrome (header / footer) — explicit CSS because
              scrml's Tailwind layer doesn't emit:
                - color shades ≥ 950 (`bg-slate-950`)
                - opacity-suffixed bg classes (`bg-slate-900/60`)
                - `backdrop-blur` / `backdrop-filter` utilities
                - `bg-sky-500/10`, `border-sky-500/30`, etc.
              all logged in the same Bug 1 inbox note. */
        header.site-chrome {
            background-color: rgb(2 6 23 / 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgb(30 41 59);
        }
        footer.site-chrome {
            background-color: rgb(15 23 42 / 0.6);
            border-top: 1px solid rgb(30 41 59);
        }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

        /* ─── reference sidebar (generated into this shell) ─────────
           Authored ONCE here and hidden by default; each reference page
           opts in with a scoped #{} rule. The shell cannot branch on the
           route (route.* is page-scoped, E-SCOPE-001 in a program), and V1
           allows one flat <outlet> (SPEC §20.8.1), so CSS opt-in is the
           static mechanism. Zero JS, present in the server HTML. */
        .refnav { display: none; }
        .ref-shell { display: block; }
        /* a reference page sets: .ref-shell{display:grid} .refnav{display:block} */
        .ref-shell {
            grid-template-columns: 16rem minmax(0, 1fr);
            gap: 2.5rem;
            align-items: start;
        }
        /* single column on narrow viewports — the nav stacks above the article
           rather than squeezing it; `position: sticky` is dropped there too. */
        @media (max-width: 900px) {
            .ref-layout { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
            .refnav { position: static !important; max-height: none !important; }
        }
        .refnav {
            position: sticky;
            top: 5rem;
            max-height: calc(100vh - 7rem);
            overflow-y: auto;
            overscroll-behavior: contain;
            font-size: 0.8125rem;
            padding-right: 0.5rem;
            border-right: 1px solid rgb(30 41 59);
        }
        .refnav-group { margin-bottom: 1.5rem; }
        .refnav-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: rgb(100 116 139);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }
        .refnav-link {
            display: block;
            padding: 0.2rem 0.5rem;
            border-radius: 0.25rem;
            color: rgb(148 163 184);
            text-decoration: none;
            border-left: 2px solid transparent;
            overflow-wrap: anywhere;
        }
        .refnav-link:hover {
            color: rgb(241 245 249);
            background-color: rgb(30 41 59 / 0.6);
        }
        /* ACTIVE — set per page by a scoped #{} rule matching its own data-ref.
           Static: present in the server HTML, no client JS, no flash. */
        .refnav-link[data-active] {
            color: rgb(125 211 252);
            background-color: rgb(14 165 233 / 0.10);
            border-left-color: rgb(56 189 248);
            font-weight: 600;
        }
        .refnav-fam { margin-bottom: 0.15rem; }
        .refnav-fam-sum {
            cursor: pointer;
            color: rgb(148 163 184);
            padding: 0.2rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            list-style: none;
        }
        .refnav-fam-sum::-webkit-details-marker { display: none; }
        .refnav-fam-sum::before { content: "▸ "; color: rgb(71 85 105); }
        .refnav-fam[open] > .refnav-fam-sum::before { content: "▾ "; }
        .refnav-fam-sum:hover { color: rgb(241 245 249); background-color: rgb(30 41 59 / 0.6); }
        .refnav-count { color: rgb(71 85 105); font-size: 0.7rem; }
        .refnav-fam .refnav-link { padding-left: 1.25rem; font-size: 0.75rem; }
        /* STUB MARKER — 35 of 73 reference pages are ~60-word placeholders
           (prose-vs-SPEC audit 2026-07-22). Dimmed + dotted so the tree shows
           real coverage at a glance instead of promising 73 written pages. */
        .refnav-stub { opacity: 0.45; }
        .refnav-stub:hover { opacity: 0.75; }
        .refnav-stubdot { color: rgb(148 163 184); margin-left: 0.3rem; }
        .version-pill {
            font-size: 0.7rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            color: rgb(148 163 184);
            background-color: rgb(30 41 59 / 0.7);
            padding: 0.15rem 0.55rem;
            border-radius: 9999px;
            border: 1px solid rgb(51 65 85);
        }
        .built-in-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.85rem;
            border-radius: 9999px;
            background-color: rgb(14 165 233 / 0.10);
            border: 1px solid rgb(14 165 233 / 0.35);
            color: rgb(125 211 252);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.75rem;
        }
        .built-in-pill::before {
            content: "";
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 9999px;
            background-color: rgb(56 189 248);
            box-shadow: 0 0 8px rgb(56 189 248 / 0.6);
        }

        /* CTA button on landing — promote from black to indigo accent */
        a.bg-slate-900 {
            background-color: rgb(56 189 248) !important;
            color: rgb(2 6 23) !important;
        }
        a.bg-slate-900:hover {
            background-color: rgb(125 211 252) !important;
        }
    }

    <header class="site-chrome sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between gap-6">
            <a href="/" class="font-mono font-bold text-lg text-slate-100">scrml.dev</a>
            <nav class="flex items-center gap-5 text-sm text-slate-400">
                <a href="/getting-started" class="hover:text-slate-100">Get started</a>
                <a href="/learn" class="hover:text-slate-100">Learn</a>
                <a href="/reference" class="hover:text-slate-100">Reference</a>
                <a href="/showcase" class="hover:text-slate-100">Showcase</a>
                <a href="/articles" class="hover:text-slate-100">Articles</a>
                <a href="/about" class="hover:text-slate-100">About</a>
                <a href="https://github.com/bryanmaclee/scrml" class="hover:text-slate-100">GitHub</a>
            </nav>
            <span class="version-pill">${VERSION}</span>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10 min-h-screen">
        // Page-specific content renders here via filesystem routing —
        // each pages/<route>.scrml file is a `<page>` that lifts into
        // this main slot per SPEC §40 multi-page composition.
        //
        // The explicit <outlet/> (not a bare <main>) is what ENABLES soft
        // navigation: a bare <main> route slot compiles fine but leaves
        // client-side nav OFF, so every link is a full document load
        // (W-OUTLET-ABSENT-SOFT-NAV-DISABLED). On a ~100-page wiki that is
        // the difference between a site and a stack of documents.
        // ref-shell: single column by default; a reference page promotes it
        // to two columns with a scoped #{} rule. The sidebar is GENERATED and
        // hidden unless the page opts in — scripts/gen-reference-nav.mjs.
        <div class="ref-shell">
    // <<< GENERATED reference sidebar — node scripts/gen-reference-nav.mjs >>>
    <nav class="refnav" aria-label="Reference">
      <div class="refnav-group">
        <div class="refnav-title">Elements</div>
        <a href="/reference/elements/auth" data-ref="elements/auth" class="refnav-link font-mono">&lt;auth&gt;</a>
        <a href="/reference/elements/channel" data-ref="elements/channel" class="refnav-link font-mono">&lt;channel&gt;</a>
        <a href="/reference/elements/db" data-ref="elements/db" class="refnav-link font-mono refnav-stub" title="stub — not yet written">&lt;db&gt;<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/elements/engine" data-ref="elements/engine" class="refnav-link font-mono">&lt;engine&gt;</a>
        <a href="/reference/elements/errors" data-ref="elements/errors" class="refnav-link font-mono">&lt;errors&gt;</a>
        <a href="/reference/elements/match" data-ref="elements/match" class="refnav-link font-mono">&lt;match&gt;</a>
        <a href="/reference/elements/onIdle" data-ref="elements/onIdle" class="refnav-link font-mono">&lt;onIdle&gt;</a>
        <a href="/reference/elements/onTimeout" data-ref="elements/onTimeout" class="refnav-link font-mono">&lt;onTimeout&gt;</a>
        <a href="/reference/elements/onTransition" data-ref="elements/onTransition" class="refnav-link font-mono">&lt;onTransition&gt;</a>
        <a href="/reference/elements/page" data-ref="elements/page" class="refnav-link font-mono">&lt;page&gt;</a>
        <a href="/reference/elements/program" data-ref="elements/program" class="refnav-link font-mono">&lt;program&gt;</a>
        <a href="/reference/elements/schema" data-ref="elements/schema" class="refnav-link font-mono">&lt;schema&gt;</a>
      </div>
      <div class="refnav-group">
        <div class="refnav-title">Keywords</div>
        <a href="/reference/keywords/derived" data-ref="keywords/derived" class="refnav-link font-mono">derived</a>
        <a href="/reference/keywords/is-some" data-ref="keywords/is-some" class="refnav-link font-mono">is-some</a>
        <a href="/reference/keywords/lift" data-ref="keywords/lift" class="refnav-link font-mono">lift</a>
        <a href="/reference/keywords/req" data-ref="keywords/req" class="refnav-link font-mono">req</a>
      </div>
      <div class="refnav-group">
        <div class="refnav-title">Contexts</div>
        <a href="/reference/contexts/logic" data-ref="contexts/logic" class="refnav-link font-mono">logic</a>
        <a href="/reference/contexts/meta" data-ref="contexts/meta" class="refnav-link font-mono">meta</a>
        <a href="/reference/contexts/sql" data-ref="contexts/sql" class="refnav-link font-mono">sql</a>
      </div>
      <div class="refnav-group">
        <div class="refnav-title">Errors &amp; warnings</div>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-AUTH-… <span class="refnav-count">2</span></summary>
        <a href="/reference/errors/E-AUTH-GRAPH-002" data-ref="errors/E-AUTH-GRAPH-002" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-AUTH-GRAPH-002<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/errors/E-AUTH-GRAPH-003" data-ref="errors/E-AUTH-GRAPH-003" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-AUTH-GRAPH-003<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-CHANNEL-… <span class="refnav-count">5</span></summary>
        <a href="/reference/errors/E-CHANNEL-008" data-ref="errors/E-CHANNEL-008" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-CHANNEL-008<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/errors/E-CHANNEL-INSIDE-PAGE" data-ref="errors/E-CHANNEL-INSIDE-PAGE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-CHANNEL-INSIDE-PAGE<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/errors/E-CHANNEL-INSIDE-PROGRAM" data-ref="errors/E-CHANNEL-INSIDE-PROGRAM" class="refnav-link font-mono">E-CHANNEL-INSIDE-PROGRAM</a>
        <a href="/reference/errors/E-CHANNEL-OUTSIDE-PROGRAM" data-ref="errors/E-CHANNEL-OUTSIDE-PROGRAM" class="refnav-link font-mono">E-CHANNEL-OUTSIDE-PROGRAM</a>
