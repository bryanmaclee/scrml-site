        <a href="/reference/errors/E-ENGINE-VAR-DUPLICATE" data-ref="errors/E-ENGINE-VAR-DUPLICATE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-ENGINE-VAR-DUPLICATE<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-EQ-… <span class="refnav-count">1</span></summary>
        <a href="/reference/errors/E-EQ-004" data-ref="errors/E-EQ-004" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-EQ-004<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-ERRORS-… <span class="refnav-count">2</span></summary>
        <a href="/reference/errors/E-ERRORS-001" data-ref="errors/E-ERRORS-001" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-ERRORS-001<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/errors/E-ERRORS-002" data-ref="errors/E-ERRORS-002" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-ERRORS-002<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-HISTORY-… <span class="refnav-count">1</span></summary>
        <a href="/reference/errors/E-HISTORY-NO-INNER-ENGINE" data-ref="errors/E-HISTORY-NO-INNER-ENGINE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-HISTORY-NO-INNER-ENGINE<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-IDLE-… <span class="refnav-count">3</span></summary>
        <a href="/reference/errors/E-IDLE-DUPLICATE" data-ref="errors/E-IDLE-DUPLICATE" class="refnav-link font-mono">E-IDLE-DUPLICATE</a>
        <a href="/reference/errors/E-IDLE-INVALID-VARIANT" data-ref="errors/E-IDLE-INVALID-VARIANT" class="refnav-link font-mono">E-IDLE-INVALID-VARIANT</a>
        <a href="/reference/errors/E-IDLE-MISPLACED" data-ref="errors/E-IDLE-MISPLACED" class="refnav-link font-mono">E-IDLE-MISPLACED</a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-INTERNAL-… <span class="refnav-count">1</span></summary>
        <a href="/reference/errors/E-INTERNAL-RULE-NOT-COMPOSITE" data-ref="errors/E-INTERNAL-RULE-NOT-COMPOSITE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-INTERNAL-RULE-NOT-COMPOSITE<span class="refnav-stubdot" aria-label="stub">·</span></a>
        </details>
        <details class="refnav-fam">
