        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-COMPONENT-… <span class="refnav-count">1</span></summary>
        <a href="/reference/errors/E-COMPONENT-ENGINE-SCOPE" data-ref="errors/E-COMPONENT-ENGINE-SCOPE" class="refnav-link font-mono">E-COMPONENT-ENGINE-SCOPE</a>
        </details>
        <details class="refnav-fam">
          <summary class="refnav-fam-sum font-mono">E-DERIVED-… <span class="refnav-count">4</span></summary>
        <a href="/reference/errors/E-DERIVED-ENGINE-NO-INITIAL" data-ref="errors/E-DERIVED-ENGINE-NO-INITIAL" class="refnav-link font-mono">E-DERIVED-ENGINE-NO-INITIAL</a>
        <a href="/reference/errors/E-DERIVED-VALUE-MUTATE" data-ref="errors/E-DERIVED-VALUE-MUTATE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-DERIVED-VALUE-MUTATE<span class="refnav-stubdot" aria-label="stub">·</span></a>
        <a href="/reference/errors/E-DERIVED-WITH-VALIDATORS" data-ref="errors/E-DERIVED-WITH-VALIDATORS" class="refnav-link font-mono">E-DERIVED-WITH-VALIDATORS</a>
        <a href="/reference/errors/E-DERIVED-WRITE" data-ref="errors/E-DERIVED-WRITE" class="refnav-link font-mono refnav-stub" title="stub — not yet written">E-DERIVED-WRITE<span class="refnav-stubdot" aria-label="stub">·</span></a>
